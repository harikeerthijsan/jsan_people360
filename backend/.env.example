# =====================================================================
# JSAN People360 -- backend environment
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_NAME=JSAN People360
APP_ENV=local                       # local | development | staging | production | test
APP_VERSION=0.1.0
JP360_DEBUG=true                    # MUST be false outside local development
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------
# Security -- REQUIRED
# Generate a fresh key per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------
SECRET_KEY=change-me-to-a-64-character-random-string-before-you-run-anything
JWT_ALGORITHM=HS256
JWT_ISSUER=jsan-people360
JWT_AUDIENCE=jsan-people360-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12                   # 12+ outside automated tests

# ---------------------------------------------------------------------
# Refresh token cookie
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=none when the frontend is served
# from a different site over HTTPS.
# ---------------------------------------------------------------------
REFRESH_COOKIE_NAME=jp360_refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax                 # lax | strict | none

# ---------------------------------------------------------------------
# Database
# Either set the individual POSTGRES_* values or a full DATABASE_URL.
# DATABASE_URL wins when both are present.
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jsan_people360
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jsan_people360

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------
# CORS -- comma separated list of allowed browser origins
# ---------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=INFO                      # CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_FORMAT=console                  # console (local) | json (staging/production)
LOG_REQUEST_BODY=false

# ---------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------
# UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------------
# Outbound mail
# Leave SMTP_HOST blank in development: reset emails are written to the log.
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=JSAN People360

# ---------------------------------------------------------------------
# Frontend -- used to build password reset links
# ---------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Bootstrap administrator (development only)
# Change the password immediately in any shared environment.
# ---------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME=System Administrator

# ---------------------------------------------------------------------
# Trusted hosts
#
# Comma separated hostnames this API will answer to. Empty means "any",
# which is fine locally and refused in production: the Host header is
# reflected into password-reset links, so a forged one sends a working
# reset token to somebody else's domain.
#
# Production example: TRUSTED_HOSTS=api.example.com,people.example.com
# ---------------------------------------------------------------------
TRUSTED_HOSTS=

# ---------------------------------------------------------------------
# Request limits
#
# The rate limit counts *failed* attempts per client address on the
# credential endpoints only. Successful sign-ins cost nothing, so an
# office sharing one NAT gateway is never throttled while a client
# guessing passwords is stopped quickly.
#
# It is held in process memory: with N workers the effective limit is N
# times this value, and a restart forgets. Size a cluster's real limit at
# the edge instead.
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

# Outer bound on any request body. Larger than MAX_UPLOAD_SIZE_MB on
# purpose: a multipart upload carries the file plus its form fields, so a
# limit equal to the file limit would reject a file of the permitted size.
MAX_REQUEST_BODY_MB=12
