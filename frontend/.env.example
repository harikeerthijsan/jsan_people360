# =====================================================================
# JSAN People360 -- frontend environment
#
# Copy to `.env.local` (git-ignored):
#   PowerShell:  Copy-Item .env.example .env.local
#   bash:        cp .env.example .env.local
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# Never put a secret behind that prefix.
# =====================================================================

# Base URL of the FastAPI backend, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Shown in the browser tab, the sidebar header and the sign-in card.
NEXT_PUBLIC_APP_NAME=JSAN People360

# Surfaced in the UI footer to make environment mix-ups obvious.
NEXT_PUBLIC_APP_ENV=local
