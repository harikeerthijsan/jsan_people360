# =====================================================================
# JSAN People360
# =====================================================================

# ---------------------------------------------------------------------
# Secrets -- never commit a real environment file.
# Only the *.example templates belong in version control.
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
secrets/

# ---------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / typing caches
.pytest_cache/
# Hyphenated variants left behind by earlier `cache_dir` / `--basetemp` settings
# that pointed pytest at the working tree. Both now use their defaults.
.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ---------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------
node_modules/
.next/
out/
build/
.swc/
*.tsbuildinfo
next-env.d.ts

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

coverage/
.eslintcache
.prettiercache

# ---------------------------------------------------------------------
# Runtime artefacts
# ---------------------------------------------------------------------
# Uploaded files are user data, not source. The directory itself is tracked
# via uploads/.gitkeep so the path exists on a fresh clone.
uploads/*
!uploads/.gitkeep

logs/
*.log

# ---------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini
